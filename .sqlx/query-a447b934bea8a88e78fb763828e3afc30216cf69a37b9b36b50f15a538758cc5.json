  "query": "SELECT window.root_id,window.opened_at,window.last_arrival_at,0 AS pending_count, window.held_since,window.retry_not_before, window.retry_attempts,window.window_id FROM subscription_windows window JOIN board_messages root ON root.message_id=window.root_id AND root.root_id IS NULL WHERE window.reader_key=? AND root.topic_id=? AND NOT EXISTS(SELECT 1 FROM thread_subscriptions thread_override WHERE thread_override.reader_key=window.reader_key AND thread_override.scope_kind='thread' AND thread_override.scope_id=window.root_id) ORDER BY window.root_id",
